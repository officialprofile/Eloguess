{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "jsx": "react-jsx",
    "strict": true, "noEmit": true, "allowImportingTsExtensions": true,
    "esModuleInterop": true, "skipLibCheck": true, "resolveJsonModule": true,
    "types": ["node", "vite/client"]
  },
  "include": ["packages/chess-core/src", "web/src", "vite.config.ts"]
}
