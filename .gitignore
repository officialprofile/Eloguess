# Publish only the website and the files needed to build and deploy it.
# Research, datasets, reports, tests and local tools stay on this machine.
/*
!/.gitignore
!/.npmrc
!/.nvmrc
!/README.md
!/THIRD_PARTY.md
!/package.json
!/package-lock.json
!/tsconfig.json
!/vite.config.ts

!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/checks.yml
!/.github/workflows/pages.yml

!/web/
/web/*
!/web/index.html
!/web/src/
!/web/public/
/web/public/*
!/web/public/models/
/web/public/models/*
!/web/public/models/elo-gru-v1.json
!/web/public/models/manifest.json

!/packages/
/packages/*
!/packages/chess-core/
/packages/chess-core/*
!/packages/chess-core/src/

!/fixtures/
/fixtures/*
!/fixtures/demo.pgn

!/tools/
/tools/*
!/tools/prepare-engine.mjs

# Also exclude local/generated files inside the allowed source directories.
node_modules/
dist/
__pycache__/
*.pyc
.env
.env.*
